# Токен основного бота из @BotFather
BOT_TOKEN=

# Домен сервиса. Mini App открывается только по HTTPS.
DOMAIN=dnd.example.ru
PUBLIC_URL=https://dnd.example.ru
MINI_APP_URL=https://dnd.example.ru/

# polling — для разработки, webhook — на сервере (docker-compose включает его сам)
BOT_MODE=polling
# Секрет вебхука: латиница, цифры, _ и -
WEBHOOK_SECRET=

PORT=3000
DATABASE_PATH=data/tg-dnd.sqlite

# Telegram ID первых администраторов через запятую
ADMIN_TG_IDS=

CLUB_TIMEZONE=Europe/Moscow
